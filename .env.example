NODE_ENV=production
PORT=30008

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saaluvesa_database
DB_USER=root
DB_PASSWORD=your_database_password
DB_SYNC=false

# CORS
CORS_ORIGIN=https://saaluvesa.com,https://saaluvesadashboard.saaluvesa.com

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Admin Seed
SEED_ADMIN_EMAIL=admin@saaluvesa.com
SEED_ADMIN_PASSWORD=your_admin_password_here

# SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@saaluvesa.com
SMTP_PASSWORD=your_email_app_password_here
SMTP_FROM="Saaluvesa Enterprises <contact@saaluvesa.com>"
CONTACT_RECIPIENT=contact@saaluvesa.com
